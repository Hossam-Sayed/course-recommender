<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>course-recommender-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>course-recommender</artifactId>
    <packaging>jar</packaging>

    <name>Course Recommender</name>
    <description>Main Spring Boot application for Course Recommender</description>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>course-recommender-bean</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version> <!-- Use a recent version -->
                <executions>
                    <!-- Prepares the JaCoCo agent for tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Generates the JaCoCo report after tests have run -->
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase> <!-- Or test, depends on when you want to generate -->
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Optional: Enforce coverage thresholds -->
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum> <!-- 80% line coverage -->
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum> <!-- 70% branch coverage -->
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- Exclude specific classes/packages from coverage check if needed -->
                            <excludes>
                                <exclude>**/model/**</exclude> <!-- Exclude JPA Entities -->
                                <exclude>**/dto/**</exclude> <!-- Exclude DTOs -->
                                <exclude>**/CourseRecommenderApplication.class</exclude> <!-- Exclude main app class -->
                                <exclude>**/mapper/**</exclude> <!-- Exclude Mappers -->
                                <exclude>**/config/**</exclude> <!-- Exclude Configs -->
                                <exclude>**/repository/**</exclude> <!-- Exclude Repositories -->
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!-- Exclude classes from the coverage report itself -->
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/CourseRecommenderApplication.class</exclude>
                        <exclude>**/mapper/**</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/repository/**</exclude>
                        <exclude>com/example/course_recommender_bean/service/CourseRecommender.class</exclude>
                        <exclude>com/example/course_recommender_bean/service/CourseRecommenderImpl.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
