<wsdl:definitions name="CourseRecommendationService"
                  targetNamespace="http://example.com/course-recommender/wsdl"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:rec="http://example.com/course-recommender/recommendations"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="http://example.com/course-recommender/wsdl">

    <!-- Import the XSDs that define the message types -->
    <wsdl:types>
        <xsd:schema targetNamespace="http://example.com/course-recommender/wsdl">
            <xsd:import namespace="http://example.com/course-recommender/recommendations"
                        schemaLocation="course-recommendation.xsd"/>
            <xsd:import namespace="http://example.com/course-recommender/courses"
                        schemaLocation="course.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Define the message for the request -->
    <wsdl:message name="GetRecommendedCoursesRequestMessage">
        <wsdl:part name="parameters" element="rec:GetRecommendedCoursesRequest"/>
    </wsdl:message>

    <!-- Define the message for the response -->
    <wsdl:message name="GetRecommendedCoursesResponseMessage">
        <wsdl:part name="parameters" element="rec:GetRecommendedCoursesResponse"/>
    </wsdl:message>

    <!-- Define the portType (interface) for the service -->
    <wsdl:portType name="CourseRecommendationPortType">
        <wsdl:operation name="GetRecommendedCourses">
            <wsdl:input message="tns:GetRecommendedCoursesRequestMessage"/> <!-- Use tns prefix for messages -->
            <wsdl:output message="tns:GetRecommendedCoursesResponseMessage"/> <!-- Use tns prefix for messages -->
        </wsdl:operation>
    </wsdl:portType>

    <!-- Define the binding (how the service is accessed) -->
    <wsdl:binding name="CourseRecommendationBinding"
                  type="tns:CourseRecommendationPortType"> <!-- Use tns prefix for portType -->
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetRecommendedCourses">
            <soap:operation soapAction="http://example.com/course-recommender/recommendations/GetRecommendedCourses"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Define the service itself -->
    <wsdl:service name="CourseRecommendationService">
        <wsdl:port name="CourseRecommendationPort"
                   binding="tns:CourseRecommendationBinding"> <!-- Use tns prefix for binding -->
            <soap:address location="http://localhost:8088/mockCourseRecommendations"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
